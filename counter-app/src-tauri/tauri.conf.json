{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XC Counter",
  "version": "0.1.0",
  "identifier": "cloud.spacing.xc-counter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "XC Counter",
        "create": false,
        "fullscreen": true,
        "url": "pair.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
