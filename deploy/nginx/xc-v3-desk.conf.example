# Example only; the host's owner applies it. Nothing in this repository
# installs or reloads nginx.
#
# Desk / admin host(s) of the XCHANGE v3 server: everything is proxied to the
# one v3 process on 127.0.0.1. The split between hosts is done here, by nginx —
# the server itself does not look at which host it is called as (it only
# compares Origin with Host). The customer host is the other file,
# xc-v3-customer.conf.example, and lets only the kiosk through.
#
# Replace before use: the server_name values, certificate paths, and the port
# (APP_APPLICATION__PORT). The server terminates TLS on this nginx (origin TLS);
# plain HTTP on port 80 is redirected to HTTPS per location, except for the ACME
# challenge path which answers on port 80 for certbot webroot renewals.
#
# The proxy_set_header lines are at server level on purpose: a location that
# sets any proxy_set_header of its own drops ALL of these (nginx inherits them
# only when the location has none). Do not add one inside a location.

server {
    listen 80;
    listen [::]:80;
    # nginx on the live host takes "listen 443 ssl http2;". nginx >= 1.25.1 prefers "listen 443 ssl;" + "http2 on;".
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name xc-desk.example.com xc-admin.example.com;

    include snippets/acme-challenge.conf;
    include snippets/ssl-params.conf;

    ssl_certificate /etc/letsencrypt/live/xc-desk.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xc-desk.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Uploads are accepted up to 15 MB by the server
    # (api/src/infrastructure/files/file_service.rs MAX_UPLOAD_BYTES), sent as
    # the raw request body. 16m = that limit plus margin, so that the server —
    # not nginx — answers a file that is too large, with its own message.
    client_max_body_size 16m;

    proxy_http_version 1.1;
    proxy_read_timeout 60s;

    # Passed through unchanged: the server builds its own origin from Host and
    # refuses a POST whose Origin differs.
    proxy_set_header Host $host;

    # Overwrites whatever the client sent. The server reads only X-Real-IP at
    # every door (owner sign-in, staff sign-in, kiosk): all per-address rate
    # and attempt limits key on this header (api/src/presentation/http/client_address.rs).
    # If the client's own X-Real-IP were passed on, one machine could pick a new
    # "address" for every guess and the limits would count nothing.
    proxy_set_header X-Real-IP $remote_addr;

    # The server reads only X-Real-IP and never trusts CF-Connecting-IP directly.
    # nginx forwards request headers it is not told about, so an untrusted client
    # reaching this host could send its own CF-Connecting-IP. An empty value removes
    # the header so nothing downstream can see or trust it.
    proxy_set_header CF-Connecting-IP "";

    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # The server uses this to build its origin (https://<host>) and redirects.
    # On port 443 it is "https"; on port 80 plain HTTP is redirected before proxying.
    proxy_set_header X-Forwarded-Proto $scheme;

    # --- Behind Cloudflare (required: cloudflare-realip.conf) ---------------
    # Behind Cloudflare, $remote_addr is a Cloudflare edge address unless nginx
    # replaces it (ngx_http_realip_module). Without realip, all visitors share
    # edge addresses and the per-address sign-in limit locks everyone out together.
    #
    # Required: generate and install the http-level realip configuration from
    # deploy/nginx/cloudflare-realip.conf.example (/etc/nginx/conf.d/cloudflare-realip.conf).
    # That sets the trusted Cloudflare ranges and real_ip_header CF-Connecting-IP at
    # http level — do not add real_ip_header inside this server block.
    #
    # Close this host's ports 80 and 443 to everything but Cloudflare's ranges (firewall).
    # With realip active, $remote_addr carries the real visitor, X-Real-IP forwards
    # it to the server, and CF-Connecting-IP stays cleared.
    # -----------------------------------------------------------------------

    # API answers are per user and must never be stored or replayed.
    location /api/ {
        if ($scheme = http) {
            return 301 https://$host$request_uri;
        }
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_pass http://127.0.0.1:8094;
    }

    # Pages, static files, uploaded files, /healthz and /health/ready. The
    # server sets Cache-Control itself (pages: no-store).
    location / {
        if ($scheme = http) {
            return 301 https://$host$request_uri;
        }
        proxy_cache off;
        proxy_pass http://127.0.0.1:8094;
    }
}
