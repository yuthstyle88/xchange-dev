# Example only; the host's owner applies it. Nothing in this repository
# installs or reloads nginx.
#
# Customer (kiosk) host once /api/kiosk is answered by the v3 server. It is
# deploy/nginx/xc-customer.conf (phase 1: Flutter web build + v2 on :8093) with
# two changes: the upstream is the v3 port, and the client-address headers are
# set as the v3 server needs them. Until v3's /api/kiosk is on main and
# installed, xc-customer.conf is the file in use — do not apply this one.
#
# Host split: this host serves the kiosk files and POST /api/kiosk only. No
# other path reaches the server from here; sign-in, desk and admin live on the
# desk host (xc-v3-desk.conf.example).
#
# Replace before use: server_name, certificate paths, the port, the web root. Behind Cloudflare,
# the http-level realip configuration is required (cloudflare-realip.conf.example).
# The server terminates TLS on this nginx (origin TLS); plain HTTP on port 80 is
# redirected to HTTPS per location, except for the ACME challenge path which answers
# on port 80 for certbot webroot renewals.

server {
    listen 80;
    listen [::]:80;
    # nginx on the live host takes "listen 443 ssl http2;". nginx >= 1.25.1 prefers "listen 443 ssl;" + "http2 on;".
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name xc-customer.example.com;

    include snippets/acme-challenge.conf;
    include snippets/ssl-params.conf;

    ssl_certificate /etc/letsencrypt/live/xc-customer.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xc-customer.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 64k;

    root /var/www/xc-customer/web;
    index index.html;

    # --- Behind Cloudflare (required: cloudflare-realip.conf) ---------------
    # Behind Cloudflare, $remote_addr is a Cloudflare edge address unless nginx
    # replaces it (ngx_http_realip_module). Without realip, all kiosk customers
    # share edge addresses and one busy minute exhausts the 20/min quote limit
    # for everyone.
    #
    # Required: generate and install the http-level realip configuration from
    # deploy/nginx/cloudflare-realip.conf.example (/etc/nginx/conf.d/cloudflare-realip.conf).
    # That sets the trusted Cloudflare ranges and real_ip_header CF-Connecting-IP at
    # http level — do not add real_ip_header inside this server block.
    #
    # Close this host's ports 80 and 443 to everything but Cloudflare's ranges (firewall).
    # With realip active, $remote_addr carries the real visitor, X-Real-IP forwards
    # it to the server, and CF-Connecting-IP stays cleared.
    # -----------------------------------------------------------------------

    location = /api/kiosk {
        if ($scheme = http) {
            return 301 https://$host$request_uri;
        }
        if ($request_method != POST) {
            return 405;
        }

        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;

        proxy_pass http://127.0.0.1:8094/api/kiosk;
        proxy_http_version 1.1;

        # Passed through unchanged: the server verifies Origin against Host.
        proxy_set_header Host $host;

        # Overwrites whatever the client sent. The server reads only X-Real-IP
        # at every door: /api/kiosk's per-address quote limit (20 a minute) keys
        # on this header (api/src/presentation/http/client_address.rs).
        proxy_set_header X-Real-IP $remote_addr;

        # Clear untrusted client headers; the server reads only X-Real-IP.
        proxy_set_header CF-Connecting-IP "";

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # The server uses this to build its origin (https://<host>) and redirects.
        # On port 443 it is "https"; on port 80 plain HTTP is redirected before proxying.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Entry points, loaders, and version manifests must not be cached.
    # Locations with their own add_header do not inherit server-level add_header,
    # so Strict-Transport-Security must be repeated here.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json)$ {
        if ($scheme = http) {
            return 301 https://$host$request_uri;
        }
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    # All other paths serve static assets or fall back to /index.html (SPA)
    location / {
        if ($scheme = http) {
            return 301 https://$host$request_uri;
        }
        try_files $uri $uri/ /index.html;
    }
}
