# /etc/xc-v3/env — settings of the XCHANGE v3 server, read by systemd
# (EnvironmentFile=) and by `xchange create-owner`.
# Owner root, group xc-v3, mode 640. install.sh writes the real file on the host;
# this example holds names and placeholders only. Never commit a real value.
#
# Every setting of api/configuration/base.yaml can be overridden as
# APP_<SECTION>__<KEY> (prefix APP, separator "__"), see api/src/config/mod.rs.

# Which api/configuration/<name>.yaml is laid over base.yaml:
# development | staging | production. production gives channel "release".
APP_ENVIRONMENT=staging
# Directory holding base.yaml and the per-environment files.
APP_CONFIG_DIR=/opt/xc-v3/configuration

# Address the server listens on. Keep it on loopback: the server trusts the
# X-Real-IP / X-Forwarded-Proto / Host headers, which only nginx may set.
APP_APPLICATION__HOST=127.0.0.1
# Port the server listens on; nginx proxies to it.
APP_APPLICATION__PORT=8094
# Optional: number of worker threads (base.yaml: 2).
#APP_APPLICATION__WORKERS=2
# Optional: seconds a stop waits for requests in flight (base.yaml: 30).
#APP_APPLICATION__SHUTDOWN_TIMEOUT_SECS=30

# PostgreSQL host.
APP_DATABASE__HOST=127.0.0.1
# Optional: PostgreSQL port (base.yaml: 5432).
#APP_DATABASE__PORT=5432
# Role the server connects as; it owns the database (migrations run at start).
APP_DATABASE__USERNAME=xc_v3
# Password of that role. Generated by install.sh on the host, never printed.
# Must start with a letter: values are type-parsed, an all-digit one is not text.
APP_DATABASE__PASSWORD=<generated on the host>
# Database name.
APP_DATABASE__DATABASE_NAME=xc_v3
# Optional: require TLS to PostgreSQL (base.yaml: false; same host needs none).
#APP_DATABASE__REQUIRE_SSL=false
# Optional: connection pool upper bound (base.yaml: 10).
#APP_DATABASE__MAX_CONNECTIONS=10
# Optional: connection pool lower bound (base.yaml: 1).
#APP_DATABASE__MIN_CONNECTIONS=1
# Optional: seconds to wait for a free connection (base.yaml: 5).
#APP_DATABASE__ACQUIRE_TIMEOUT_SECS=5

# Directory of the pages and static files extracted from the v2 bundle.
APP_WEB__DIR=/opt/xc-v3/web
# Directory uploaded files are kept in; must be in the unit's ReadWritePaths.
APP_FILES__DIR=/var/lib/xc-v3/uploads

# Optional: seconds between two purges of expired sessions and past sign-in windows; the first runs at start; at least 1 (base.yaml: 3600).
#APP_AUTH__PURGE_INTERVAL_SECS=3600

# Optional: name written into the logs (base.yaml: xchange).
#APP_TELEMETRY__SERVICE_NAME=xchange
# Optional: log level (base.yaml: info).
#APP_TELEMETRY__LOG_LEVEL=info
# Optional: logs as JSON lines (base.yaml: false).
#APP_TELEMETRY__JSON_LOGS=false

# Do not set APP_CHANNEL: the channel comes from APP_ENVIRONMENT
# (staging.yaml -> staging, production.yaml -> release).
