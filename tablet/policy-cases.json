    { "url": "https://tablet.xchange.test/app/queue?branch=MAIN&from=sign-in", "expect": "allow", "why": "W5: the page after sign-in" },
    { "url": "https://tablet.xchange.test/app/queue?branch=MAIN#pair=ABCDE-FGHJK", "expect": "allow", "why": "W5, W10: the admin pairing QR (T-D10)" },
    { "url": "https://tablet.xchange.test/app/queue#pair=ABCDEFGHJK", "expect": "allow", "why": "W5, W10: a typed code (W-D8)" },
