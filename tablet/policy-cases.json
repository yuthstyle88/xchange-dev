    { "url": "https://tablet.xchange.test/app/notifications", "expect": "start", "why": "W6" },
    { "url": "https://tablet.xchange.test/app/branches", "expect": "start", "why": "W6" },
    { "url": "https://tablet.xchange.test/app/bookings", "expect": "start", "why": "W6" },
