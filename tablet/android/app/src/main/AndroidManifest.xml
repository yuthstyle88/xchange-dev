<?xml version="1.0" encoding="utf-8"?>
<!-- TW-0 skeleton (kiosk-shared-phone §7.11.4 W-D1, W-D2; §7.11.5). Minimal so the app builds; TW-2 completes it
     (window flags, back handling, the code scanner's module meta-data). The id is com.spacing.xchange.tablet,
     set in app/build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".TabletActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
    </application>
</manifest>
